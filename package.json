{
	"name": "suite-shuffle",
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": "^24.0.0",
		"npm": "^12.0.0"
	},
	"scripts": {
		"check": "biome check --write .",
		"check:unsafe": "biome check --write --unsafe .",
		"test": "vitest run",
