		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/node": "^24.13.3",
		"knip": "^6.32.2",
		"lefthook": "^2.1.10",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"allowScripts": {
		"lefthook": true
	}
}
